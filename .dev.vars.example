# ==============================================================================
# Cloudflare Wrangler Local Development Variables (.dev.vars.example)
# ==============================================================================
#
# PURPOSE:
# Cloudflare Pages Functions run inside Cloudflare's edge V8 runtime. When running
# local development with Wrangler ('npx wrangler pages dev public'), Wrangler reads
# this file (.dev.vars in the project root) to populate 'context.env' in:
#   - functions/api/status.js
#   - functions/api/chat.js
#   - functions/api/confirm.js
#
# INSTRUCTIONS:
# 1. Copy this file to '.dev.vars' in the project root:
#      cp .dev.vars.example .dev.vars
# 2. Replace placeholders with your actual API keys and tokens.
# 3. Start local development server:
#      npm run dev
#      # (or: npx wrangler pages dev public)
#
# CLOUDFLARE PAGES PRODUCTION DEPLOYMENT:
# In production, do NOT upload this file. Configure variables in the Cloudflare Dashboard:
#   Pages Project -> Settings -> Environment Variables:
#   - Encrypted Secrets: GEMINI_API_KEY, GITHUB_TOKEN
#   - Plain Text Variables: GEMINI_MODEL, GITHUB_OWNER, GITHUB_REPO, GITHUB_BRANCH
#
# SECURITY WARNING:
# NEVER commit '.dev.vars' to Git. It is excluded by .gitignore.
# ==============================================================================

# Google Gemini API Key (Secret) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model identifier (Default: gemini-3.6-flash or gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.6-flash

# GitHub Personal Access Token with repo or contents:write scope (Secret) - https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Target GitHub Repository Owner (User or Organization)
GITHUB_OWNER=LoupiBe

# Target GitHub Repository Name (containing schedule.json)
GITHUB_REPO=train-station-timetable

# Target Git Branch for schedule.json operations
GITHUB_BRANCH=main
