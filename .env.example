# ==============================================================================
# Train Station ChatOps - Environment Configuration Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local Node.js testing, scripts, and CI:
#      cp .env.example .env
# 2. Fill in your actual credentials and repository settings below.
# 3. For local Cloudflare Pages Functions development with Wrangler, use:
#      cp .dev.vars.example .dev.vars
#
# SECURITY WARNING:
# NEVER commit '.env' or any file containing live tokens to Git!
# Real credentials must remain strictly local or in encrypted Cloudflare secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# GEMINI_API_KEY (Required, Secret)
# Used by Cloudflare Pages Functions (/api/chat) to converse with the Google
# Gemini REST API (v1beta) and trigger structured function calling.
# Generate your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL (Optional, Default: gemini-2.0-flash)
# Model identifier for Gemini chat completions and tool invocations.
# Default & Recommended: gemini-2.0-flash (fast, reliable tool-calling).
# Supported fallbacks: gemini-1.5-flash, gemini-1.5-pro.
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. GitHub REST API Integration Configuration
# ------------------------------------------------------------------------------
# GITHUB_TOKEN (Required, Secret)
# Personal Access Token (PAT) used by /api/status (GET schedule.json) and
# /api/confirm (PUT schedule.json commit with atomic SHA check).
#
# Required Token Permissions:
# - Classic Token: 'repo' scope (or 'public_repo' if repository is public).
# - Fine-Grained Token: Repository access to target repo with 'Contents: Read and write'.
# Generate your token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token_here

# GITHUB_OWNER (Required, Default: LoupiBe)
# GitHub username or organization owning the train station timetable repository.
GITHUB_OWNER=LoupiBe

# GITHUB_REPO (Required, Default: train-station-timetable)
# Name of the GitHub repository holding the authoritative 'schedule.json'.
GITHUB_REPO=train-station-timetable

# GITHUB_BRANCH (Optional, Default: main)
# Branch where 'schedule.json' is fetched from and committed to.
GITHUB_BRANCH=main
