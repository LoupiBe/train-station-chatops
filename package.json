{
  "name": "train-station-chatops",
  "version": "0.1.1",
  "private": true,
  "description": "Standalone ChatOps PWA for train station timetable & holiday management via Cloudflare Pages and Gemini API",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "build": "node -e 'console.log(\"Build complete: static PWA assets in public/ require no compilation.\")'",
    "test": "node --test",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:e2e": "node --test 'tests/e2e/**/*.test.js'",
    "lint": "git ls-files -z '*.js' | xargs -0 -r -n 1 node --check",
    "bump": "node scripts/bump-version.js"
  },
  "keywords": [
    "chatops",
    "pwa",
    "cloudflare-pages",
    "gemini-api",
    "kiosk",
    "timetable",
    "belgium",
    "genval"
  ],
  "author": "LoupiBe",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}
